+    /// G04 的**像素影响面论证（纯函数口径）**：只有跨字形种类的边界才加宽，
+    /// 所以只有含中英混排的行会动，纯中文/纯英文/纯全角标点的盒宽**一个像素都不变**。
+    #[test]
+    fn only_mixed_script_lines_gain_width() {
+        let size = 16.0f32;
+        // 0 加宽：这些文本的盒宽在修复前后完全相同 → 相关基线不会漂
+        for text in [
+            "中文主题",
+            "一二三四五六七八九十",
+            "Expanded Topic",
+            "Rust 2026",
+            "1234",
+            "中文，标点。",
+            "……——",
+        ] {
+            assert_eq!(
+                line_advance(0.0, text, size),
+                0.0,
+                "{text} 的盒宽不该变（零边界）"
+            );
+        }
+        // 有加宽：等于 边界数 × 1.6px；n 不可能超过字数，所以单行加宽 ≤ 字数 × 0.1em
+        for (text, n) in [("中文Rust", 1.0), ("A中", 1.0), ("中A文B", 3.0)] {
+            let gain = line_advance(0.0, text, size);
+            assert!(
+                (gain - n * 0.1 * size).abs() < 1e-3,
+                "{text}: 加宽 {gain:.3}px，应 = {n}×1.6px"
+            );
+            let chars = text.chars().count() as f32;
+            assert!(gain <= chars * 0.1 * size, "{text}: 加宽不能超过字数上限");
+        }
+    }
+
+    /// 画布净宽（只问 DWrite，不加间距）—— 用来验证度量与渲染真的走同一句。
+    fn dwrite_net_width(dw: &DWrite, text: &str, font_size: f32, weight: u16) -> f32 {
+        let format = dw.format(font_size, weight).expect("TextFormat");
+        let units = utf16_units(text);
+        let layout = unsafe {
+            dw.factory()
+                .CreateTextLayout(&units, &format, NO_WRAP, f32::MAX)
+        }
+        .expect("TextLayout");
+        unsafe { layout.SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP) }.expect("nowrap");
+        let mut metrics = DWRITE_TEXT_METRICS::default();
+        unsafe { layout.GetMetrics(&mut metrics) }.expect("metrics");
+        metrics.width.max(0.0)
+    }
+
+    /// **G04 的等式**：`measure()` 的宽 == 渲染侧累计推进量（同一条 `line_advance`），
+    /// 且两者都比 DWrite 净宽多出「边界数 × 0.1em」。
+    #[test]
+    fn measured_width_equals_shaped_advance() {
+        let dw = DWrite::new().expect("本机必须有 DirectWrite");
+        let measurer = crate::dwrite::DWriteMeasurer::new(DWrite::new().expect("dwrite"));
+        let mut engine = TextEngine::with_dwrite(dw);
+        let samples = [
+            "中文Rust混排",
+            "中A文B混排 C 语言",
+            "纯中文一行",
+            "Plain english line",
+            "中文，标点。",
+            "2026 年版",
+        ];
+        for text in samples {
+            for size in [15.0f32, 16.0, 20.0, 28.0] {
+                let measured = measurer
+                    .measure_result(text, size, 400, NO_WRAP)
+                    .expect("measure")
+                    .width;
+                let shaped = engine.shape(text, size, 400).expect("shape").width;
+                // 1) 度量 == 渲染（同一个函数出宽；容差 0.5 css px 覆盖 DWrite 行宽取整）
+                assert!(
+                    (measured - shaped).abs() <= 0.5,
+                    "{text} @{size}: 度量 {measured:.3} ≠ 画面 {shaped:.3}"
+                );
+                // 2) 两者都 == 净宽 + 混排间距（证明加的是同一份，而不是谁多加了）
+                let net = dwrite_net_width(engine.dwrite(), text, size, 400);
+                let want = line_advance(net, text, size);
+                assert!(
+                    (measured - want).abs() <= 0.5,
+                    "{text} @{size}: 度量 {measured:.3} ≠ 净宽+间距 {want:.3}"
+                );
+                assert!(
+                    (shaped - want).abs() <= 0.5,
+                    "{text} @{size}: 画面 {shaped:.3} ≠ 净宽+间距 {want:.3}"
+                );
+            }
+        }
+    }
+}
