+    /// G04 的出宽规则：`line_advance` = 净行进 + `边界数 × 0.1em × 字号`，字号线性。
+    #[test]
+    fn line_advance_counts_every_cjk_latin_boundary() {
+        // 零边界：净宽原样返回（纯中文 / 纯英文 / 中文夹全角标点 / 空格分隔）
+        for text in ["中文主题", "Expanded Topic", "中文，标点。", "Rust 中文"] {
+            assert_eq!(
+                line_advance(100.0, text, 16.0),
+                100.0,
+                "{text} 不该有混排间距"
+            );
+        }
+        // 1 / 2 / 3 个边界：每个 0.1em × 16px = 1.6px
+        for (text, n) in [("中文Rust", 1.0), ("中文Rust混排", 2.0), ("中A文B", 3.0)] {
+            let got = line_advance(100.0, text, 16.0);
+            let want = 100.0 + n * 0.1 * 16.0;
+            assert!(
+                (got - want).abs() < 1e-3,
+                "{text}: line_advance={got:.3} 应为 {want:.3}"
+            );
+        }
+        // 字号线性：同一段 16px → 32px，间距正好翻倍
+        let gap16 = line_advance(0.0, "中文Rust", 16.0);
+        let gap32 = line_advance(0.0, "中文Rust", 32.0);
+        assert!((gap32 - gap16 * 2.0).abs() < 1e-3, "间距必须随字号线性");
+    }
