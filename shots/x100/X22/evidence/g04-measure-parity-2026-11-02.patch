+/// 混排行会顶出节点盒、居中偏「间距和 / 2」）。
+pub(crate) fn line_advance(dwrite_advance: f32, text: &str, font_size: f32) -> f32 {
+    dwrite_advance + cjk_latin_gap_width(text, font_size)
+}
