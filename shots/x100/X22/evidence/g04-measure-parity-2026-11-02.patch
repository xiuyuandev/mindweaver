+/// 一段文字要额外推进的**中英混排间距**：`边界数 × 0.1em × 字号`。
+///
+/// 边界指「汉字 ↔ ASCII 字母数字」（[`cjk_latin_gaps`]），空格已经承担分隔的不算。
+/// 这是间距规则的唯一实现：渲染步进与度量补宽都从这里取数（X22 G04）。
+pub(crate) fn cjk_latin_gap_width(text: &str, font_size: f32) -> f32 {
+    cjk_latin_gaps(text).len() as f32 * CJK_LATIN_GAP_EM * font_size
+}
