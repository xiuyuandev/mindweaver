+    /// 只问 DWrite 的净宽（不加混排间距），用来钉「度量 == 净宽 + 间距」。
+    fn net_width(dw: &DWrite, text: &str, font_size: f32) -> f32 {
+        let format = dw.format(font_size, WEIGHT_NORMAL).expect("TextFormat");
+        let units = utf16_units(text);
+        let layout = unsafe {
+            dw.factory()
+                .CreateTextLayout(&units, &format, NO_WRAP, UNBOUNDED_HEIGHT)
+        }
+        .expect("TextLayout");
+        unsafe { layout.SetWordWrapping(DWRITE_WORD_WRAPPING_NO_WRAP) }.expect("nowrap");
+        let mut metrics = DWRITE_TEXT_METRICS::default();
+        unsafe { layout.GetMetrics(&mut metrics) }.expect("metrics");
+        metrics.width.max(0.0)
+    }
+
+    /// **X22 G04 的契约**：`Measured.width` 是画布真画出来的推进量——DWrite 净宽
+    /// 再加中英混排 0.1em；纯中文/纯英文加 0，所以那些盒宽一点不变。
+    #[test]
+    fn measure_adds_cjk_latin_gaps_to_the_dwrite_width() {
+        let dw = test_dwrite();
+        let measurer = DWriteMeasurer::new(test_dwrite());
+        for size in [15.0f32, 16.0, 20.0, 28.0] {
+            for (text, boundaries) in [
+                ("中文Rust混排", 2.0f32),
+                ("中A文B", 3.0),
+                ("纯中文一行", 0.0),
+                ("Plain english line", 0.0),
+                ("中文，标点。", 0.0),
+            ] {
+                let measured = measurer
+                    .measure_result(text, size, WEIGHT_NORMAL, NO_WRAP)
+                    .expect("measure")
